# Runtime connection. Use the provider's pooled URL for serverless deployments
# when it supplies one; otherwise use the direct PostgreSQL URL.
DATABASE_URL=

# Direct PostgreSQL connection used by Prisma migrations. For local development
# this can be the same URL as DATABASE_URL.
DIRECT_URL=

# Optional canonical public origin. Set this for a custom Vercel domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000